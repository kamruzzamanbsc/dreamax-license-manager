{
  "name": "dreamax-soft/dreamax-license-manager",
  "description": "Self-hosted WooCommerce license management",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.0",
    "ext-json": "*",
    "ext-sodium": "*"
  },
  "require-dev": {
    "php-stubs/woocommerce-stubs": "^11.0",
    "phpstan/phpstan": "^1.12 || ^2.0",
    "phpunit/phpunit": "^9.6 || ^10.5",
    "squizlabs/php_codesniffer": "^3.10",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": {
    "classmap": [
      "src/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Dreamax\\LicenseManager\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "@php vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=2G",
    "lint": "@php vendor/bin/phpcs",
    "phpcs": "@lint",
    "migration:verify": "@php scripts/verify-migration-contract.php --environment-marker=DREAMAX_LM_DISPOSABLE_TEST",
    "benchmark:smoke": "@php scripts/performance-benchmark.php --profile=smoke --seed=free-v1-smoke-20260825 --environment-marker=DREAMAX_LM_DISPOSABLE_TEST",
    "release:validate": "@php scripts/validate-release-metadata.php",
    "build": "@php scripts/build-release.php"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
