{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dreamax-license-manager-release-manifest/v1",
  "title": "Dreamax License Manager release-candidate provenance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema",
    "plugin_name",
    "plugin_version",
    "artifact_filename",
    "artifact_status",
    "source_git_commit",
    "source_state",
    "build_command",
    "build_profile",
    "distribution_zip_sha256",
    "dependency_lock_sha256",
    "dependency_license_inventory_reference",
    "tested_versions",
    "build_test_utc",
    "release_gate_evidence_reference",
    "build_tool_versions",
    "inventory_filename",
    "inventory_sha256",
    "file_count",
    "source_date_epoch",
    "reproducibility_result",
    "limitations"
  ],
  "properties": {
    "manifest_schema": {"const": "docs/release-manifest.schema.json"},
    "plugin_name": {"const": "Dreamax License Manager"},
    "plugin_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "artifact_filename": {"type": "string", "pattern": "^dreamax-license-manager-[0-9]+\\.[0-9]+\\.[0-9]+\\.zip$"},
    "artifact_status": {"const": "unshipped_release_candidate_verification"},
    "source_git_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "source_state": {"const": "clean_recorded_commit"},
    "build_command": {"type": "string"},
    "build_profile": {"const": "wordpress-org-release-candidate"},
    "distribution_zip_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dependency_lock_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dependency_license_inventory_reference": {"const": "docs/DEPENDENCIES.md"},
    "tested_versions": {"type": "object", "required": ["wordpress", "woocommerce", "php"]},
    "build_test_utc": {"type": "string", "format": "date-time"},
    "release_gate_evidence_reference": {"type": "string"},
    "build_tool_versions": {"type": "object", "required": ["php", "composer", "git", "ziparchive"]},
    "inventory_filename": {"const": "release-inventory.json"},
    "inventory_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file_count": {"type": "integer", "minimum": 1},
    "source_date_epoch": {"type": "integer", "minimum": 315532800},
    "reproducibility_result": {"type": "object", "required": ["status", "builds", "sha256_match", "inventory_match"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
